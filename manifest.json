{
  "manifest_version": 3,
  "name": "Force Paste Enabler",
  "version": "1.0",
  "description": "Allows pasting in restricted form fields when enabled via the toolbar icon.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "32": "icon-off.svg"
  },
  "action": {
    "default_title": "Force Paste: OFF",
    "default_icon": {
      "32": "icon-off.svg"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "force-paste@yourdomain.local"
    }
  }
}